@page "/look/{entityId?}/{eid?}"

@using Factograph.Data
@using Factograph.Data.r

@inject Factograph.Data.IFDataService db

@{
    RRecord? rr = db.GetRRecord(entityId, true);
    string tp = rr == null ? "notype" : rr.Tp;
    if (rr != null)
    {
        <div>Смотреть (look) id=@entityId tp=@tp</div>
        <div>
            @((MarkupString)rr.BuildPortrait(null, 2))
        </div>
    }
}

@code {
    [Parameter] // Фокусная запись
    public string? entityId { get; set; }
    [Parameter] // Внешная запись
    public string? eid { get; set; }

}